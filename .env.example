# Copy this file to .env and fill in the values
# NEVER commit .env to git

# Flask
# REQUIRED. Must be a unique, high-entropy value (>= 32 chars) — it signs session
# cookies AND CSRF tokens. The app refuses to boot on a placeholder/short key.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_ENV=production

# Set to 'true' ONLY when the site is served over HTTPS end-to-end (domain + TLS
# cert). Over plain HTTP a Secure cookie is dropped by the browser and login breaks.
SESSION_COOKIE_SECURE=false

# PostgreSQL — format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://faktura_user:your_password@localhost:5432/faktura_db

# Tesseract OCR (Linux path after apt-get install tesseract-ocr)
TESSERACT_CMD=/usr/bin/tesseract

# Poppler (Linux path after apt-get install poppler-utils)
POPPLER_PATH=/usr/bin

# File storage — use absolute paths on your server
UPLOAD_FOLDER=/opt/faktura-scanner/data/uploads
PDF_FOLDER=/opt/faktura-scanner/data/pdfs
TEMP_DIR=/opt/faktura-scanner/data/temp

# ── SMS links + scheduler ───────────────────────────────────────────────────────────────────
# Canonical https DOMAIN every SMS link is built from ({BASE_URL}/confirm/<token>, /cancel, /rate,
# /visit, /booking). In production the app REFUSES TO BOOT while the SMS scheduler is enabled and
# this is unset, localhost, a raw IP, or plain http. Verify with:
#   python scripts/smoke_public_links.py https://<host>      (before pointing BASE_URL at a host)
BASE_URL=https://www.example.com
# Exactly one service per database should send texts. Preview/staging services that share the DB
# but must NOT text clients set this to 0.
ENABLE_SMS_SCHEDULER=1
# Client self-service on the public SMS pages: online cancel allowed until this many hours before
# the visit (decision D3); later the page says to phone the salon. SALON_PHONE is shown there.
CLIENT_CANCEL_CUTOFF_HOURS=12
SALON_PHONE=

# ── Cloudflare Turnstile (bot check on the public booking page) ──────────────────────────────
# Set BOTH or NEITHER. The site key is public (rendered into the page); the secret key never
# leaves this file. Unset secret = check skipped (booking stays open, a warning is logged);
# set secret but no site key = every booking refused (an error is logged at boot).
# Local dev: Cloudflare's always-pass test pair is
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Rate limiting (public booking: 10/hour + 30/day per visitor IP, 3/day per phone number) ──
# In-memory counters are right for the single gunicorn worker (reset on restart). Use Redis
# (redis://host:6379) before ever running more than one worker.
RATELIMIT_STORAGE_URI=memory://

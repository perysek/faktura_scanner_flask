# Copy this file to .env and fill in the values
# NEVER commit .env to git

# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=production

# PostgreSQL — format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://faktura_user:your_password@localhost:5432/faktura_db

# Tesseract OCR (Linux path after apt-get install tesseract-ocr)
TESSERACT_CMD=/usr/bin/tesseract

# Poppler (Linux path after apt-get install poppler-utils)
POPPLER_PATH=/usr/bin

# File storage — use absolute paths on your server
UPLOAD_FOLDER=/opt/faktura-scanner/data/uploads
PDF_FOLDER=/opt/faktura-scanner/data/pdfs
TEMP_DIR=/opt/faktura-scanner/data/temp
